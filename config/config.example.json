{
  "config": {
    "drive_config": {
      "service_file": "service_account.json",
      "remote_file": "PriceMonitor"
    },
    "llm_config": {
      "provider": "gemini_search",
      "model": "gemini-3.7-flash",
      "api_key": "<fernet-encrypted-token — see README 'Encrypting the API key'>",
      "max_tokens": 1024,
      "temperature": 0.0
    },
    "price_ctrl": {
      "refresh_rate_h": 24,
      "poll_rate_m": 5,
      "items_sheet": "Items",
      "history_sheet": "Prices",
      "control_sheet": "Control",
      "ratings_sheet": "Ratings",
      "currency": "GBP",
      "suspect_threshold": 0.5,
      "drop_step": 0.05,
      "min_readings": 3,
      "best_window_days": 7,
      "resweep_thin": true,
      "report_keep_days": 30,
      "rating_rate_d": 30,
      "min_confidence": 0.5,
      "rating_premium_pct": 0.05,
      "max_plausible_price": 100000,
      "request_delay_s": 2
    },
    "msg_config": {
      "handle": "pm",
      "router_endpoint": "tcp://127.0.0.1:5555",
      "sub_endpoint": "tcp://127.0.0.1:5556",
      "timeout_ms": 2000
    }
  }
}
